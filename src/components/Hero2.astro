---
// Hero.astro
---

<section class="w-full min-h-[800px] flex items-center py-12 md:py-0">
  <div
    class="w-full flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12"
  >
    <!-- Left content (order-2 on mobile, order-1 on desktop) -->
    <div class="flex-1 max-w-2xl flex flex-col items-center md:items-start text-center md:text-left order-2 md:order-1">
      <h1
        class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-black leading-tight flex items-center justify-center md:justify-start gap-3 flex-wrap"
        style="font-weight: 800;"
      >
        <span>¡Hola!</span>
        <span class="inline-block animate-wave origin-[70%_70%]">👋</span>
        <span>Soy</span>
      </h1>

      <h2
        class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight mt-1 hero-gradient-text"
        style="font-weight: 800;"
      >
        Luis Salazar
      </h2>

      <p class="mt-6 text-xl md:text-2xl text-gray-500 leading-relaxed">
        Soy un <span class="font-bold text-black">desarrollador Full Stack</span> enfocado
        en crear soluciones web completas, integrando frontend moderno y backend robusto de alto impacto digital.
      </p>

      <div class="mt-8 flex justify-center md:justify-start w-full">
        <a
          href="/proyectos"
          class="inline-block bg-blue-500 hover:bg-black transition-colors text-white font-medium text-base md:text-lg px-8 py-3.5 rounded-full shadow-sm"
        >
          Ver portafolio
        </a>
      </div>
    </div>

    <!-- Right avatar (order-1 on mobile, order-2 on desktop) -->
    <div class="flex-shrink-0 order-1 md:order-2 flex justify-center">
      <!-- 👇 AQUÍ SE CAMBIA EL TAMAÑO DE LA FOTO DEL HERO: modifica los valores de w-[...] y h-[...] -->
      <div
        class="group/hero relative w-[240px] h-[240px] md:w-[290px] md:h-[290px] rounded-full bg-gradient-to-br from-blue-400 via-cyan-400 to-emerald-400 overflow-hidden flex items-end justify-center p-2 cursor-pointer transition-transform duration-300 hover:scale-[1.02]"
      >
        <img
          src="/luis-salazar.png"
          alt="Luis Salazar avatar"
          class="w-full h-full object-cover object-top transition-opacity duration-300 group-hover/hero:opacity-0"
        />
        <img
          src="/luis-salazar-coqueto.png"
          alt="Luis Salazar avatar coqueto"
          class="absolute inset-0 w-full h-full object-cover object-top p-2 transition-opacity duration-300 opacity-0 group-hover/hero:opacity-100"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-gradient-text {
    background: linear-gradient(
      90deg,
      #04adee 0%,
      #52b0e7 20%,
      #03d5db 40%,
      #03d5bb 60%,
      #08cea5 80%,
      #0ccb97 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  @keyframes wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    15% {
      transform: rotate(14deg);
    }
    30% {
      transform: rotate(-8deg);
    }
    45% {
      transform: rotate(14deg);
    }
    60% {
      transform: rotate(-4deg);
    }
    75% {
      transform: rotate(10deg);
    }
  }
  .animate-wave {
    animation: wave 2.2s infinite;
  }
</style>
