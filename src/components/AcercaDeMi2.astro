---
// Essence.astro
const cards = [
  {
    emoji: "🤔",
    title: "¿Quién soy?",
    description:
      "Soy un desarrollador web Full Stack enfocado en crear soluciones digitales integrales, combinando frontend atractivo y backend de alto rendimiento.",
  },
  {
    emoji: "🧠",
    title: "Mi Filosofía",
    description: "El gran desarrollo web une claridad visual, código limpio, usabilidad y rendimiento impecable.",
  },
  {
    emoji: "✨",
    title: "Mi Enfoque",
    description:
      "Conecto el diseño moderno con la ingeniería de software para construir soluciones escalables y funcionales.",
  },
];
---

<section class="w-full bg-white py-20 md:py-28">
  <div class="w-full">
    <!-- Header -->
    <div class="flex flex-col items-center text-center mb-16">
      <span
        class="bg-gray-100 text-gray-600 text-sm font-medium px-4 py-1.5 rounded-full mb-6"
      >
        Esencia
      </span>
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-black mb-6"
      >
        Detrás de Pantalla
      </h2>
      <p
        class="text-xl md:text-2xl text-gray-500 max-w-2xl leading-relaxed font-medium"
      >
        Un vistazo a mi mentalidad, estilo de trabajo y enfoque técnico.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        cards.map((card) => (
          <div class="bg-gray-100 rounded-3xl px-8 py-12 flex flex-col items-center text-center">
            <span class="text-5xl mb-6">{card.emoji}</span>
            <h3 class="text-2xl md:text-3xl font-bold text-black mb-3">
              {card.title}
            </h3>
            <p class="text-gray-500 text-lg leading-relaxed">
              {card.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
