---
// FloatingNav.astro
const navItems = [
  { name: "Home", label: "Inicio", href: "/" },
  { name: "Portfolio", label: "Portafolio", href: "/proyectos" },
  { name: "About", label: "Sobre mí", href: "/acerca-de-mi" },
  { name: "Blog", label: "Blog", href: "/blog" },
];
---

<section id="floating-menu" transition:persist="floating-menu" class="fixed bottom-5 sm:bottom-7 left-1/2 -translate-x-1/2 z-50">
  <nav
    class="glass-nav rounded-full w-[340px] max-w-[95vw] h-[64px] p-1.5 flex items-center justify-between gap-1"
  >
    {
      navItems.map((item, index) => (
        <a
          href={item.href}
          data-nav-link
          data-nav-name={item.name}
          class={`flex-1 h-full flex flex-col items-center justify-center gap-1 rounded-full transition-all duration-300 ${
            index === 0
              ? "glass-item-active"
              : "glass-item-inactive hover:bg-white/40"
          }`}
        >
          {item.name === "Home" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class={`w-[22px] h-[22px] transition-colors ${index === 0 ? "text-blue-500" : "text-slate-600"}`}
            >
              <path d="M3 10.5 12 3l9 7.5" />
              <path d="M5 9.5V21h14V9.5" />
            </svg>
          )}
          {item.name === "Portfolio" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class={`w-[22px] h-[22px] transition-colors ${index === 0 ? "text-blue-500" : "text-slate-600"}`}
            >
              <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.379a1.5 1.5 0 0 1 1.06.44L11.06 6.56a1.5 1.5 0 0 0 1.06.44H19.5A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5v-11z" />
            </svg>
          )}
          {item.name === "About" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class={`w-[22px] h-[22px] transition-colors ${index === 0 ? "text-blue-500" : "text-slate-600"}`}
            >
              <circle cx="12" cy="12" r="10" />
              <circle cx="12" cy="9.5" r="3.2" fill="white" />
              <path
                d="M5.5 18.2a7.2 7.2 0 0 1 13 0A9.96 9.96 0 0 1 12 22a9.96 9.96 0 0 1-6.5-3.8z"
                fill="white"
              />
            </svg>
          )}
          {item.name === "Blog" && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class={`w-[22px] h-[22px] transition-colors ${index === 0 ? "text-blue-500" : "text-slate-600"}`}
            >
              <path d="M17 3a2.83 2.83 0 0 1 4 4L7 21l-4 1 1-4L17 3z" />
            </svg>
          )}

          <span
            class={`text-[11px] font-medium leading-none tracking-tight transition-colors ${index === 0 ? "text-blue-500" : "text-slate-600"}`}
          >
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>
</section>

<style>
  .glass-nav {
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow:
      0 12px 40px -6px rgba(0, 0, 0, 0.09),
      0 4px 16px -2px rgba(0, 0, 0, 0.03),
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.95);
  }

  .glass-item-active {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.95);
  }

  .glass-item-inactive {
    background: transparent;
    border: 1px solid transparent;
  }
</style>

<script>
  function updateActiveNav() {
    const navLinks =
      document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
    if (!navLinks.length) return;

    const currentPath = window.location.pathname.replace(/\/$/, "") || "/";

    function setActive(name: string) {
      navLinks.forEach((link) => {
        const linkName = link.getAttribute("data-nav-name");
        const isActive = linkName === name;
        const icon = link.querySelector("svg");
        const span = link.querySelector("span");

        if (isActive) {
          link.classList.add("glass-item-active");
          link.classList.remove("glass-item-inactive", "hover:bg-white/40");
          if (icon) {
            icon.classList.add("text-blue-500");
            icon.classList.remove("text-slate-600");
          }
          if (span) {
            span.classList.add("text-blue-500");
            span.classList.remove("text-slate-600");
          }
        } else {
          link.classList.remove("glass-item-active");
          link.classList.add("glass-item-inactive", "hover:bg-white/40");
          if (icon) {
            icon.classList.remove("text-blue-500");
            icon.classList.add("text-slate-600");
          }
          if (span) {
            span.classList.remove("text-blue-500");
            span.classList.add("text-slate-600");
          }
        }
      });
    }

    if (currentPath.startsWith("/blog")) {
      setActive("Blog");
    } else if (currentPath.startsWith("/proyectos")) {
      setActive("Portfolio");
    } else if (currentPath.startsWith("/acerca-de-mi")) {
      setActive("About");
    } else {
      setActive("Home");
    }
  }

  window.addEventListener("scroll", updateActiveNav, { passive: true });
  document.addEventListener("DOMContentLoaded", updateActiveNav);
  document.addEventListener("astro:page-load", updateActiveNav);
  setTimeout(updateActiveNav, 50);
</script>
