---
// Header.astro - Transparent glassmorphic header
---

<header id="main-header" transition:persist="main-header" class="fixed top-0 left-0 z-40 w-full glass-header transition-all duration-300">
  <div class="w-full max-w-[1200px] mx-auto px-6 sm:px-8 md:px-8 py-4 sm:py-5 flex items-center justify-between">
    <a
      href="/"
      aria-label="Luis Salazar - Inicio"
      class="group flex items-center transition-transform hover:scale-105 duration-200"
    >
      <div
        class="relative w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-gradient-to-br from-blue-400 via-cyan-400 to-emerald-400 overflow-hidden flex items-end justify-center shadow-sm p-2"
      >
        <img
          src="/luis-salazar.png"
          alt="Luis Salazar"
          class="w-full h-full object-cover object-top transition-opacity duration-200 group-hover:opacity-0"
        />
        <img
          src="/luis-salazar-coqueto.png"
          alt="Luis Salazar coqueto"
          class="absolute inset-0 w-full h-full object-cover object-top p-2 transition-opacity duration-200 opacity-0 group-hover:opacity-100"
        />
      </div>
    </a>

    <a
      href="/#contacto"
      class="inline-flex items-center justify-center bg-blue-500 hover:bg-black active:scale-95 transition-all duration-200 text-white font-medium text-sm sm:text-base px-6 py-2.5 rounded-full"
    >
      Contacto
    </a>
  </div>
</header>

<style>
  .glass-header {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: none;
    box-shadow: none;
  }
</style>