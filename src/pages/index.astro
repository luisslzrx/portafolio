---
import Layout from "../layouts/Layout.astro";
import Hero2 from "../components/Hero2.astro";
import AcercaDeMi2 from "../components/AcercaDeMi2.astro";
import Proyecto2 from "../components/Proyecto2.astro";
import Experiencia2 from "../components/Experiencia2.astro";
import Beneficios from "../components/Beneficios.astro";
import Blogs from "../components/Blogs.astro";
---

<Layout>
  <main class="w-full max-w-[1200px] mx-auto px-6 sm:px-8 md:px-8">
    <section id="inicio">
      <Hero2 />
    </section>
    <section id="acerca-de-mi">
      <AcercaDeMi2 />
    </section>
    <section id="beneficios">
      <Beneficios />
    </section>
    <section id="experiencia">
      <Experiencia2 />
    </section>
  </main>

  <section id="proyectos" class="w-full overflow-hidden">
    <Proyecto2 />
  </section>

  <main class="w-full max-w-[1200px] mx-auto px-6 sm:px-8 md:px-8">
    <section id="blogs">
      <Blogs />
    </section>
  </main>
</Layout>
