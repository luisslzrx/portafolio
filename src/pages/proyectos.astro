---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const rawProjects = await getCollection("proyectos");
rawProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const projects = rawProjects.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  image: p.data.image,
  tags: (p.data.tags || []).slice(0, 2),
  link: p.data.link,
}));
---

<Layout
  title="Portafolio | Luis Salazar - Proyectos"
  description="Colección de proyectos de desarrollo web, aplicaciones y soluciones digitales desarrolladas por Luis Salazar."
  url="https://luissalazar.com.mx/proyectos"
>
  <main class="w-full max-w-[1200px] mx-auto px-6 sm:px-8 md:px-8 pt-28 md:pt-32 pb-16 md:pb-24">
    <section class="w-full bg-white">
      <div class="w-full">
        <!-- Header -->
        <div class="flex flex-col items-center text-center mb-16">
          <span class="bg-gray-100 text-gray-600 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
            Portafolio
          </span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-black mb-6">
            Proyectos Destacados
          </h1>
          <p class="text-xl md:text-2xl text-gray-500 max-w-2xl leading-relaxed">
            Una colección de proyectos de desarrollo web construidos con propósito, calidad y atención al detalle.
          </p>
        </div>

        <!-- Project cards -->
        <div class="flex flex-col gap-8">
          {projects.map((project) => (
            <div class="bg-gray-100 rounded-3xl p-6 md:p-10 flex flex-col md:flex-row items-center gap-8 md:gap-12">
              <!-- Image / device mockup -->
              <div class="w-full md:w-1/2 h-64 sm:h-72 md:h-80 bg-gray-200 rounded-2xl overflow-hidden shrink-0 relative">
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="block w-full h-full overflow-hidden">
                    <img
                      src={project.image}
                      alt={project.title}
                      class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
                    />
                  </a>
                ) : (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top"
                  />
                )}
              </div>

              <!-- Content -->
              <div class="w-full md:w-1/2 flex flex-col self-stretch justify-between py-2">
                <div>
                  <h3 class="text-2xl md:text-3xl font-bold text-black mb-4">
                    {project.title}
                  </h3>
                  <p class="text-gray-500 text-base md:text-lg leading-relaxed mb-6">
                    {project.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-2.5 mt-auto pt-6 md:justify-end">
                  {project.tags.map((tag) => (
                    <span class="bg-gray-200 text-gray-700 text-sm md:text-base font-medium px-4 md:px-5 py-1.5 md:py-2 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>