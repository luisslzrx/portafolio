---
import "../styles/global.css";
import "@fontsource-variable/inter";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer2 from "../components/Footer2.astro";
import Menu from "../components/Menu.astro";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  url?: string;
  author?: string;
  type?: string;
  siteName?: string;
  locale?: string;
  card?: string;
}

const {
  title = "Luis Salazar | Desarrollador Full Stack & Web Developer",
  description = "Desarrollador Web Full Stack con experiencia en frontend y backend creando soluciones web completas con HTML, CSS, JavaScript, Astro, Tailwind, Python Django, PHP y WordPress.",
  keywords = "desarrollador full stack, desarrollador web frontend y backend, desarrollador Astro México, desarrollador WordPress profesional, desarrollador web con enfoque UX UI",
  image = "/luisdev-logo.png",
  url = "https://luissalazar.com.mx",
  author = "Luis Salazar",
  type = "website",
  siteName = "Luis Salazar - Desarrollador Web",
  locale = "es_MX",
  card = "summary_large_image",
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter Display / Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="MX-VER" />
    <meta name="geo.placename" content="Veracruz, México" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={card} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content={author} />

    <!-- Canonical URL -->
    <link rel="canonical" href={url} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Luis Salazar",
        "jobTitle": "Desarrollador Full Stack",
        "description": "Desarrollador Web Full Stack con experiencia en frontend y backend creando soluciones integrales con HTML, CSS, JavaScript, Astro, Tailwind, Python Django, PHP y WordPress.",
        "url": "https://luissalazar.com.mx",
        "image": "https://luissalazar.com.mx/luisdev-logo.png",
        "sameAs": [
          "https://github.com/luisslzrx",
          "https://www.linkedin.com/in/luis-gerardo-salazar-aguilar/"
        ],
        "knowsAbout": [
          "HTML",
          "CSS",
          "JavaScript",
          "Astro",
          "Tailwind CSS",
          "Python Django",
          "PHP",
          "WordPress",
          "UX/UI",
          "SEO técnico"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Veracruz",
          "addressCountry": "MX"
        }
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <Header transition:persist="main-header" />
    <slot />
    <Footer2 />
    <Menu transition:persist="floating-menu" />
  </body>
</html>
